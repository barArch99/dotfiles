{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // Para cambiar la imagen: reemplaza ~/.config/fastfetch/logo.png (PNG, mejor cuadrada)
    "logo": {
        "type": "kitty-direct",
        "source": "~/.config/fastfetch/logo.png",
        "width": 34,
        "height": 16,
        "padding": { "top": 0, "left": 2, "right": 4 }
    },
    "display": {
        "separator": " - ",
        "color": { "keys": "cyan", "separator": "blue" }
    },
    "modules": [
        { "type": "custom", "format": "{#36}● {#34}● {#35}● {#32}● {#33}● {#31}● {#37}●{#}" },
        "break",
        { "type": "title", "format": "{#1;36}{user-name}{#34}@{#1;36}{host-name}{#}" },
        "break",
        { "type": "os",       "key": "\udb82\udcc7", "format": "{pretty-name} {arch}" },
        { "type": "kernel",   "key": "\uf17c" },
        { "type": "packages", "key": "\udb80\udfd6" },
        { "type": "shell",    "key": "\uf489" },
        { "type": "terminal", "key": "\uf120" },
        { "type": "wm",       "key": "\uf2d2" },
        { "type": "cpu",      "key": "\uf2db", "format": "{name}" },
        { "type": "gpu",      "key": "\udb82\udcae", "format": "{name}" },
        { "type": "memory",   "key": "\udb80\udf5b" },
        { "type": "uptime",   "key": "\uf017" },
        { "type": "localip",  "key": "\udb82\ude5f" },
        "break",
        { "type": "custom", "format": "{#36}● {#34}● {#35}● {#32}● {#33}● {#31}● {#37}●{#}" }
    ]
}
